#!/bin/bash
# Non-blocking finisher for the kairos_vm role (rendered when kairos_vm_wait=false).
# Waits for the PXE-install VM to power off after dd, then boots the node from
# its freshly-written disk. Runs detached (setsid) so the playbook returns
# immediately and a second compute node can be brought up concurrently.
set -uo pipefail

PID=$(cat "{{ kairos_pid_file }}" 2>/dev/null)
echo "[finish] {{ kairos_node_name }}: waiting for install VM (pid ${PID:-?}) to power off after dd..."
TIMEOUT=1800; ELAPSED=0
while [ "$ELAPSED" -lt "$TIMEOUT" ]; do
  kill -0 "$PID" 2>/dev/null || { echo "[finish] install VM powered off at ${ELAPSED}s"; break; }
  sleep 10; ELAPSED=$((ELAPSED + 10))
done
if kill -0 "$PID" 2>/dev/null; then
  echo "[finish] TIMEOUT after ${TIMEOUT}s — install VM still running, aborting disk boot"
  exit 1
fi

echo "[finish] booting {{ kairos_node_name }} from disk..."
# Reuse the shared launcher (boot from disk, stay up).
"{{ build_dir }}/kairos-qemu-{{ kairos_vm_slug }}.sh" c
echo "[finish] {{ kairos_node_name }} booting from disk (serial: {{ kairos_serial_log }})"
