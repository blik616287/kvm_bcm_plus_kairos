#!/bin/bash
# Kairos dd-install as a BCM node-installer FINALIZE script (profile: {{ kairos_profile }}).
#
# Rendered by roles/deploy_dd/tasks/finalize.yml when deploy_dd_finalize_install=true.
# Runs in the node-installer (NFS) environment after provisioning, before reboot:
#   - the rootfs is NFS, so the dd never overwrites what this script runs from
#     (no "timeout: not found", no XFS console spam);
#   - {{ kairos_target_disk }} is a clean target, so sgdisk + the COS_PERSISTENT
#     grow work;
#   - on a UEFI node-installer /sys/firmware/efi/efivars is present, so efibootmgr
#     can create a boot entry (else the image's ESP fallback loader boots).
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
set +e
DISK="{{ kairos_target_disk }}"
HEAD_IP="{{ bcm_internal_ip }}"
RAW_URL="http://${HEAD_IP}:8888/{{ kairos_profile }}/disk.raw.lz4"
WIPE_DISKS="{{ kairos_wipe_disks | default('') }}"

echo "[kairos-finalize $(date)] start -> ${DISK}"

# --- Drive inventory (name/size/model). NVMe naming is NOT stable across machines,
# so log the physical layout to verify kairos_os_raid/kairos_data_raid target the
# intended drives (e.g. the OS mirror must land on the two matched OS disks, not a
# data disk). A size-mismatched OS mirror thrashes and hangs boot. ---
echo "[kairos-finalize $(date)] === drive inventory ==="
for _dev in /sys/block/nvme*n1; do
    [ -e "${_dev}" ] || continue
    _n=$(basename "${_dev}")
    _gb=$(($(cat "${_dev}/size" 2> /dev/null || echo 0) / 2 / 1024 / 1024))
    _model=$(tr -s ' ' < "${_dev}/device/model" 2> /dev/null)
    echo "  DRIVE ${_n} ${_gb}GB ${_model}"
done
# Stable identifiers, to populate a kairos_raid_select: path (or id) profile.
echo "[kairos-finalize $(date)] by-path map (for kairos_raid_select: path):"
ls -l /dev/disk/by-path/ 2> /dev/null | awk '/nvme/{print "  "$(NF-2)" -> "$NF}' || true

# Quiet the kernel console: the dd over the target still triggers some block noise.
echo 1 > /proc/sys/kernel/printk 2> /dev/null || true

# Release the freshly-provisioned target so dd can overwrite the WHOLE disk. We
# unmount /localdisk here (needed so the post-dd partition-table re-read + grow
# work); the node-installer's own post-finalize cleanup is bypassed by the forced
# reboot at the end.
sync
swapoff -a 2> /dev/null || true
for mp in $(awk -v d="${DISK}" '$1 ~ ("^" d) {print $2}' /proc/mounts | sort -r); do
    umount -fl "$mp" 2> /dev/null || true
done
umount -Rfl /localdisk 2> /dev/null || true
vgchange -an 2> /dev/null || true
mdadm --stop "${DISK}"* 2> /dev/null || true
dmsetup remove_all 2> /dev/null || true
udevadm settle --timeout=20 2> /dev/null || true
# Wipe only AFTER the holders are released: wiping signatures out from under a live
# device is what produced the EBUSY/partprobe failures. The var list is a floor, not
# the truth — names are not stable across boots — so union it with everything the
# kernel exposes, including the 2nd-controller paths (*c*n*) the var list omits.
_WIPE="${WIPE_DISKS}"
for _wd in /sys/block/nvme*n1; do
    [ -e "${_wd}" ] || continue
    _wb=$(basename "${_wd}")
    case " ${_WIPE} " in *" ${_wb} "*) ;; *) _WIPE="${_WIPE} ${_wb}" ;; esac
done
for d in ${_WIPE}; do [ -b "/dev/$d" ] && wipefs -a -f "/dev/$d" 2> /dev/null || true; done
udevadm settle --timeout=20 2> /dev/null || true

# --- Drive selection. kairos_raid_select controls how the kairos_os_raid /
# kairos_data_raid device specs resolve to real block devices:
#   name (default) -> /dev/<spec>
#   path           -> /dev/disk/by-path/<spec>  (stable per PCIe slot)
#   id             -> /dev/disk/by-id/<spec>     (stable per model+serial)
#   size           -> ignore specs; OS mirror = the smallest N drives, data = the rest
# nvmeXn1 names are NOT stable across boots on these DGX systems (a name maps to a
# different physical drive per install), so a name-pinned OS mirror can span a large
# data disk -> size-mismatched -> thrashes and hangs boot. Prefer size or path. ---
_SELECT="{{ kairos_raid_select | default('name') }}"
_resolve_dev() {
    case "${_SELECT}" in
        path) readlink -f "/dev/disk/by-path/$1" 2> /dev/null ;;
        id) readlink -f "/dev/disk/by-id/$1" 2> /dev/null ;;
        *) echo "/dev/$1" ;;
    esac
}

# Release any md array that currently holds one of our target members. A previous
# install on this node leaves md metadata that udev/mdadm auto-assembles at boot
# (--name/--homehost make that a certainty, see below); a member still held by a
# live array cannot be wiped or re-created, so the create below dies with
# "Device or resource busy" - and opaquely, because the wipe is best-effort. Stop
# the owning arrays first, then assert the members actually came free. Without
# this a RE-image of a node that already carries arrays fails where a first
# install on a bare node succeeds.
_release_md_members() {
    for _m in "$@"; do
        [ -b "${_m}" ] || continue
        _lnk="/sys/class/block/$(basename "${_m}")/md"
        [ -L "${_lnk}" ] || continue
        _md=$(basename "$(readlink "${_lnk}")")
        echo "[kairos-finalize $(date)] member $(basename "${_m}") is held by ${_md}; stopping it"
        mdadm --stop "/dev/${_md}" 2> /dev/null || mdadm --stop "${_md}" 2> /dev/null || true
    done
    udevadm settle --timeout=20 2> /dev/null || true
}
# Loud, early failure naming the device beats an opaque mdadm --create abort later.
_assert_md_members_free() {
    for _m in "$@"; do
        [ -b "${_m}" ] || continue
        _lnk="/sys/class/block/$(basename "${_m}")/md"
        if [ -L "${_lnk}" ]; then
            echo "[kairos-finalize $(date)] FATAL: member $(basename "${_m}") still held by $(basename "$(readlink "${_lnk}")") after stop; refusing to build a partial array"
            exit 1
        fi
    done
}
{% if (kairos_raid_select | default('name')) == 'size' %}
# size mode: OS mirror = smallest N (N = len(kairos_os_raid.devices)), data = the rest.
# Assumes a single data array (the DGX 2x-OS + 8x-data layout).
_OSN={{ kairos_os_raid.devices | length }}
_ALL=$(for _d in /sys/block/nvme*n1; do
    [ -e "${_d}" ] || continue
    _b=$(basename "${_d}")
    # skip the 2nd-controller paths (nvmeXcYn1): same physical drive seen twice
    case "${_b}" in *c*n*) continue ;; esac
    # skip anything whose size we cannot read: a silent 0 sorts first and would be
    # picked for the OS mirror
    _sz=$(cat "${_d}/size" 2> /dev/null) || continue
    [ -n "${_sz}" ] || continue
    [ "${_sz}" -gt 0 ] 2> /dev/null || continue
    printf '%s %s\n' "${_sz}" "${_b}"
done | sort -n | awk '{print $2}')
AUTO_OS_MEMBERS=""
AUTO_DATA_MEMBERS=""
_i=0
for _n in ${_ALL}; do
    if [ "${_i}" -lt "${_OSN}" ]; then AUTO_OS_MEMBERS="${AUTO_OS_MEMBERS}/dev/${_n} "; else AUTO_DATA_MEMBERS="${AUTO_DATA_MEMBERS}/dev/${_n} "; fi
    _i=$((_i + 1))
done
echo "[kairos-finalize $(date)] size-selected OS mirror : ${AUTO_OS_MEMBERS}"
echo "[kairos-finalize $(date)] size-selected data array: ${AUTO_DATA_MEMBERS}"
{% endif %}
{% if kairos_os_raid is defined and kairos_os_raid %}
# --- Assemble the OS RAID1 mirror BEFORE the dd. metadata=1.0 puts the superblock
# at the END of each member, so the ESP the image writes at LBA0 stays readable by
# UEFI firmware off either member. dd then targets ${DISK} (= the array). ---
{% if (kairos_raid_select | default('name')) == 'size' %}
OS_MEMBERS="${AUTO_OS_MEMBERS}"
{% else %}
OS_MEMBERS=""
for _s in {% for d in kairos_os_raid.devices %}{{ d }} {% endfor %}; do
    _r=$(_resolve_dev "${_s}")
    if [ -z "${_r}" ] || [ ! -b "${_r}" ]; then
        echo "[kairos-finalize $(date)] FATAL: kairos_os_raid device '${_s}' did not resolve to a block device (got '${_r}'); refusing to build a partial array"
        exit 1
    fi
    OS_MEMBERS="${OS_MEMBERS}${_r} "
done
{% endif %}
{% if kairos_os_raid_assert_smallest | default(true) %}
# Guard the selection: a by-path/name spec that resolves is not necessarily the
# RIGHT disk. A pin that lands on a data disk builds a RAID1 whose members differ
# in size, which thrashes and hangs boot. Members must match each other and be
# the {{ kairos_os_raid.devices | length }} smallest whole disks present.
_OS_SIZES=""
for _gm in ${OS_MEMBERS}; do
    _gz=$(cat "/sys/class/block/$(basename "${_gm}")/size" 2> /dev/null) || _gz=""
    if [ -z "${_gz}" ]; then
        echo "[kairos-finalize $(date)] FATAL: cannot read the size of OS mirror member '${_gm}'"
        exit 1
    fi
    _OS_SIZES="${_OS_SIZES} ${_gz}"
done
_FIRST=$(echo ${_OS_SIZES} | awk '{print $1}')
for _gz in ${_OS_SIZES}; do
    if [ "${_gz}" != "${_FIRST}" ]; then
        echo "[kairos-finalize $(date)] FATAL: OS mirror members differ in size (${_OS_SIZES}); check the device specs"
        exit 1
    fi
done
_SMALLEST=$(for _gd in /sys/block/nvme*n1; do
    [ -e "${_gd}" ] || continue
    _gb=$(basename "${_gd}")
    case "${_gb}" in *c*n*) continue ;; esac
    _gzz=$(cat "${_gd}/size" 2> /dev/null) || continue
    [ -n "${_gzz}" ] || continue
    [ "${_gzz}" -gt 0 ] 2> /dev/null || continue
    printf '%s %s\n' "${_gzz}" "${_gb}"
done | sort -n | awk -v n={{ kairos_os_raid.devices | length }} 'NR <= n {print $2}' | sort | tr '\n' ' ')
_MEMBERS=$(for _gm in ${OS_MEMBERS}; do basename "${_gm}"; done | sort | tr '\n' ' ')
if [ "${_SMALLEST}" != "${_MEMBERS}" ]; then
    echo "[kairos-finalize $(date)] FATAL: OS mirror members '${_MEMBERS% }' are not the {{ kairos_os_raid.devices | length }} smallest disks '${_SMALLEST% }'; check the device specs"
    exit 1
fi
echo "[kairos-finalize $(date)] OS mirror selection OK: ${_MEMBERS% } (${_FIRST} sectors each)"
{% endif %}
echo "[kairos-finalize $(date)] building OS RAID1 ${DISK} (metadata {{ kairos_os_raid.metadata | default('1.0') }}) over: ${OS_MEMBERS}"
mdadm --stop "${DISK}" 2> /dev/null || true
_release_md_members ${OS_MEMBERS}
_assert_md_members_free ${OS_MEMBERS}
for m in ${OS_MEMBERS}; do
    for mp in $(awk -v d="$m" '$1 ~ ("^" d) {print $2}' /proc/mounts | sort -r); do umount -fl "$mp" 2> /dev/null || true; done
    wipefs -a -f "$m" 2> /dev/null || true
    mdadm --zero-superblock "$m" 2> /dev/null || true
done
# --name/--homehost pin the array identity: without them mdadm stamps it
# "<hostname>:0" with a homehost that no longer matches at boot, so auto-assembly
# becomes a policy decision instead of a certainty.
# --assume-clean skips the initial resync: the dd below overwrites both members with
# the same image anyway, and the resync never finished before the forced reboot.
yes | mdadm --create "${DISK}" --level=1 --metadata={{ kairos_os_raid.metadata | default('1.0') }} \
    --raid-devices={{ kairos_os_raid.devices | length }} \
    --name=md0 --homehost=none --assume-clean --run ${OS_MEMBERS} \
    || { echo "[kairos-finalize $(date)] FATAL: mdadm --create ${DISK} failed"; exit 1; }
udevadm settle --timeout=20 2> /dev/null || true
mdadm --detail "${DISK}" 2>&1 | grep -E 'Raid Level|State|Active Devices' || true
{% endif %}

for i in $(seq 1 30); do curl --fail --silent --head "${RAW_URL}" > /dev/null 2>&1 && break; sleep 5; done
echo "[kairos-finalize $(date)] writing image..."
curl --fail -s "${RAW_URL}" | lz4 -d - - | dd of="${DISK}" bs=4M oflag=direct status=progress
sync
echo "[kairos-finalize $(date)] dd complete; fixing GPT + growing last partition..."
sgdisk -e "${DISK}" 2>&1 || true
partprobe "${DISK}" 2>&1 || true
udevadm settle --timeout=30 2> /dev/null || true

case "${DISK}" in *nvme* | *mmcblk* | *loop* | *md*) PSEP=p ;; *) PSEP= ;; esac
if command -v sgdisk > /dev/null 2>&1 && command -v resize2fs > /dev/null 2>&1; then
    LAST_NUM=$(sgdisk -p "${DISK}" 2> /dev/null | awk '/^[ ]+[0-9]+/{n=$1} END{print n}')
    LAST_INFO=$(sgdisk -i "${LAST_NUM}" "${DISK}" 2> /dev/null)
    LAST_START=$(echo "$LAST_INFO" | awk '/First sector:/{print $3}')
    LAST_TYPE=$(echo "$LAST_INFO" | awk '/Partition GUID code:/{print $4}')
    LAST_LABEL=$(echo "$LAST_INFO" | grep 'name:' | sed -e 's/.*name: //; s/^.\(.*\).$/\1/')
    if [ -n "$LAST_NUM" ] && [ -n "$LAST_START" ]; then
        echo "[kairos-finalize $(date)] growing partition ${LAST_NUM} (${LAST_LABEL}) from ${LAST_START}..."
        sgdisk -d "${LAST_NUM}" -n "${LAST_NUM}:${LAST_START}:0" -t "${LAST_NUM}:${LAST_TYPE}" -c "${LAST_NUM}:${LAST_LABEL}" "${DISK}" 2>&1 || true
        partprobe "${DISK}" 2>&1 || true
        partx -u --nr "${LAST_NUM}" "${DISK}" 2>&1 || true
        e2fsck -fy "${DISK}${PSEP}${LAST_NUM}" 2>&1 | tail -3 || true
        resize2fs "${DISK}${PSEP}${LAST_NUM}" 2>&1 | tail -3 || true
    else
        echo "[kairos-finalize $(date)] WARN: could not detect last partition; skipping grow"
    fi
fi

partprobe "${DISK}" 2> /dev/null || true
udevadm settle --timeout=20 2> /dev/null || true
# The BCM node-installer PXE-boots UEFI but does NOT mount efivarfs, so
# /sys/firmware/efi/efivars exists yet is empty and efibootmgr fails with "EFI
# variables are not supported" — its --create calls silently no-op and NO boot
# entry is written, so the node falls back to UEFI-PXE and reinstall-loops. Mount
# efivarfs ourselves, then gate on efibootmgr actually working (not just the dir).
if [ -d /sys/firmware/efi ]; then
    mount -t efivarfs efivarfs /sys/firmware/efi/efivars 2> /dev/null || true
fi
if command -v efibootmgr > /dev/null 2>&1 && efibootmgr > /dev/null 2>&1; then
    echo "[kairos-finalize $(date)] creating UEFI boot entry..."
    # drop any stale Kairos entries first
    for n in $(efibootmgr 2> /dev/null | grep 'Kairos' | grep -oE '^Boot[0-9A-Fa-f]+' | sed 's/^Boot//'); do
        efibootmgr -b "$n" -B 2> /dev/null || true
    done
    # Create a labelled entry off the (assembled) target. On RAID we deliberately point
    # --disk at ${DISK} (= /dev/md0), NOT at the member disks: the members are busy mdraid
    # devices whose partition 1 is not exposed, so "--disk <member> --part 1" fails with
    # "Could not prepare Boot variable: No such file or directory". partprobe exposed
    # ${DISK}p1 (the ESP) and the cOS image's partition GUIDs are fixed, so the resulting
    # HD(GPT,<uuid>) entry matches the ESP physically mirrored on every member (metadata 1.0).
    efibootmgr --create --disk "${DISK}" --part 1 --label Kairos --loader '\EFI\BOOT\bootx64.efi' 2>&1 || true
    # Load-bearing: make an OS entry boot BEFORE PXE. Our Kairos --create may not stick,
    # but the firmware always auto-discovers the ESP fallback as a "UEFI OS" entry
    # (\EFI\BOOT\bootx64.efi, fixed image PARTUUID). This DGX firmware otherwise rebuilds
    # BootOrder PXE-first on every POST — which is exactly what makes the node re-PXE and
    # reinstall-loop after the finalize reboot. Reorder: OS entries first, PXE entries last.
    os_boot=$(efibootmgr 2> /dev/null | grep -iE 'Kairos|UEFI OS' | grep -oE '^Boot[0-9A-Fa-f]{4}' | sed 's/^Boot//' | paste -sd, -)
    pxe_boot=$(efibootmgr 2> /dev/null | grep -iE 'PXE|Network' | grep -oE '^Boot[0-9A-Fa-f]{4}' | sed 's/^Boot//' | paste -sd, -)
    if [ -n "${os_boot}" ]; then
        neworder=$(echo "${os_boot},${pxe_boot}" | sed 's/,,*/,/g; s/,$//')
        echo "[kairos-finalize $(date)] setting BootOrder OS-first: ${neworder}"
        efibootmgr -o "${neworder}" 2>&1 || true
    fi
else
    echo "[kairos-finalize $(date)] no efivars/efibootmgr; relying on ESP fallback loader \\EFI\\BOOT\\bootx64.efi"
fi

{% if kairos_data_raid is defined and kairos_data_raid %}
# --- Data arrays (off the boot path → any level). Create + label each, then make
# them auto-mount by injecting a mountpoint + a systemd .mount unit into the cOS
# root images (active + passive). Why a baked systemd unit and not a /oem cloud-
# config: cOS's yip skips or no-ops /oem command steps at boot, cOS regenerates
# /etc/fstab, and its root is sealed read-only (can't mkdir a top-level mountpoint
# at runtime). A unit in active.img's /etc (which cOS overlays, so it shows
# through) mounts by-label at the local-fs stage, read-write, nofail = fail-open:
# a dead member never blocks boot. Mount by LABEL so it survives md renumbering. ---
{% for arr in kairos_data_raid %}
{% if (kairos_raid_select | default('name')) == 'size' %}
DATA_MEMBERS="${AUTO_DATA_MEMBERS}"
{% else %}
DATA_MEMBERS=""
for _s in {% for d in arr.devices %}{{ d }} {% endfor %}; do DATA_MEMBERS="${DATA_MEMBERS}$(_resolve_dev "${_s}") "; done
{% endif %}
DATA_COUNT=$(set -- ${DATA_MEMBERS}; echo $#)
echo "[kairos-finalize $(date)] building data array {{ arr.name }} (raid{{ arr.level }}) over: ${DATA_MEMBERS}"
mdadm --stop "/dev/md/{{ arr.name }}" 2> /dev/null || true
_release_md_members ${DATA_MEMBERS}
for m in ${DATA_MEMBERS}; do wipefs -a -f "$m" 2> /dev/null || true; mdadm --zero-superblock "$m" 2> /dev/null || true; done
yes | mdadm --create "/dev/md/{{ arr.name }}" --level={{ arr.level }} \
    --raid-devices="${DATA_COUNT}" --run ${DATA_MEMBERS} \
    || echo "[kairos-finalize $(date)] WARN: data array {{ arr.name }} create failed"
mkfs.{{ arr.filesystem | default('ext4') }} {{ '-f' if (arr.filesystem | default('ext4')) == 'xfs' else '-F' }} -L "{{ arr.name }}" "/dev/md/{{ arr.name }}" 2>&1 | tail -2 || true
{% endfor %}

echo "[kairos-finalize $(date)] injecting data mounts into cOS root images..."
STATE_DEV=$(blkid -L COS_STATE 2> /dev/null || echo "${DISK}${PSEP}4")
KF_STATE=/tmp/kfin-state
KF_IMG=/tmp/kfin-img
mkdir -p "$KF_STATE" "$KF_IMG"
if mount "$STATE_DEV" "$KF_STATE" 2> /dev/null; then
    for img in "$KF_STATE"/cOS/active.img "$KF_STATE"/cOS/passive.img; do
        [ -f "$img" ] || continue
        IL=$(losetup -f --show "$img")
        if mount "$IL" "$KF_IMG" 2> /dev/null; then
            mkdir -p "$KF_IMG/etc/systemd/system/local-fs.target.wants"
{% for arr in kairos_data_raid %}
            UNIT=$(systemd-escape -p --suffix=mount "{{ arr.mount }}" 2> /dev/null)
            [ -n "$UNIT" ] || UNIT="$(printf '%s' "{{ arr.mount }}" | sed 's|^/||; s|/|-|g').mount"
            mkdir -p "$KF_IMG{{ arr.mount }}"
            cat > "$KF_IMG/etc/systemd/system/${UNIT}" << 'UNITEOF'
[Unit]
Description=Kairos data array {{ arr.name }}
DefaultDependencies=no
Conflicts=umount.target
Before=local-fs.target umount.target
[Mount]
What=/dev/disk/by-label/{{ arr.name }}
Where={{ arr.mount }}
Type={{ arr.filesystem | default('ext4') }}
Options=noatime,nofail
[Install]
WantedBy=local-fs.target
UNITEOF
            ln -sf "../${UNIT}" "$KF_IMG/etc/systemd/system/local-fs.target.wants/${UNIT}"
{% endfor %}
            sync
            umount "$KF_IMG" 2> /dev/null || true
            echo "[kairos-finalize $(date)] injected data mounts into $(basename "$img")"
        fi
        losetup -d "$IL" 2> /dev/null || true
    done
    umount "$KF_STATE" 2> /dev/null || true
else
    echo "[kairos-finalize $(date)] WARN: could not mount COS_STATE (${STATE_DEV}) to inject data mounts"
fi
{% endif %}

# Force a real reboot instead of returning to the node-installer. BCM would
# otherwise switch_root into /localdisk and exec its /sbin/init — but we dd'd
# Kairos over the whole disk, so /localdisk is no longer a Linux root and
# switch_root drops to an emergency shell. Kairos can only be started by firmware
# (GRUB in its own ESP). The node's boot order must be disk-first / PXE-fallback,
# so this reboot lands in the freshly-written Kairos.
echo "[kairos-finalize $(date)] dd-install COMPLETE; rebooting into Kairos (bypassing node-installer switch_root)..."
sync
sleep 2
echo 1 > /proc/sys/kernel/sysrq 2> /dev/null || true
echo b > /proc/sysrq-trigger 2> /dev/null || true
reboot -f 2> /dev/null || true
systemctl --force --force reboot 2> /dev/null || true
exit 0
